@using Darbu_records.Models.Categories
@model CategoryToGroupForm

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4 p-md-5">

                    @* HEADER *@
                    <div class="d-flex align-items-center mb-5">
                        <div class="bg-dark text-white rounded-3 d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                            <i class="fa fa-tags fs-4"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">Priskirti kategorijas</h4>
                            <p class="text-muted small mb-0">Pasirinkite kategorijas šiai grupei</p>
                        </div>
                    </div>

                    <form asp-action="CategoryToGroup" method="post">

                        <input type="hidden" asp-for="id" />

                        @* KATEGORIJOS *@
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">
                                <i class="fa fa-list me-2 text-primary"></i>Kategorijų pasirinkimas
                            </h6>

                            <div class="row g-3">
                                @for (int i = 0; i < Model.categories.Count; i++)
                                {
                                    <div class="col-md-6 col-xl-4">
                                        <div class="selection-card p-3 border rounded-3 shadow-sm d-flex align-items-center">
                                            <div class="form-check m-0">
                                                <input type="hidden" asp-for="categories[i].Id" />

                                                <input class="form-check-input custom-checkbox"
                                                       type="checkbox"
                                                       asp-for="categories[i].isSelected"
                                                       id="cat_@i" />

                                                <label class="form-check-label ms-2 fw-semibold" for="cat_@i">
                                                    @Model.categories[i].Name
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        @* ACTIONS *@
                        <div class="mt-5 d-flex gap-2">
                            <button type="submit" class="btn btn-dark btn-lg px-5 fw-bold text-uppercase">
                                Išsaugoti
                            </button>

                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 fw-bold text-uppercase">
                                Atšaukti
                            </a>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .selection-card {
        transition: all 0.2s ease;
        background-color: #fcfcfc;
        cursor: pointer;
    }

        .selection-card:hover {
            border-color: #0d6efd !important;
            background-color: #f8fbff;
        }

    .custom-checkbox {
        width: 1.3rem;
        height: 1.3rem;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        user-select: none;
    }
</style>

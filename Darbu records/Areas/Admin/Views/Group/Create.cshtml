@using Darbu_records.Models.Group
@model CreateGroupForm

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-8">
            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-body p-4 p-md-5">

                    <!-- Antraštė -->
                    <h4 class="fw-bold mb-3">
                        <i class="fa fa-users me-2"></i>Sukurti naują grupę
                    </h4>
                    <p class="text-muted mb-4">Konfigūruokite grupės pavadinimą ir nuotrauką</p>

                    <form asp-controller="Group" asp-action="Create" method="post" enctype="multipart/form-data">
                        <div class="row g-4">

                            <!-- Grupės pavadinimas + nuotrauka blokas -->
                            <div class="col-12 p-3 border rounded-3 mb-4 bg-light">
                                <div class="d-flex align-items-center gap-3 flex-wrap">

                                    <!-- Pavadinimas -->

                                    <div class="flex-grow-1">
                                        <label class="form-label fw-bold small text-uppercase">Grupės pavadinimas</label>
                                        <input asp-for="group_name"
                                               class="form-control form-control-lg @(ViewData.ModelState["group_name"]?.Errors.Count > 0 ? "is-invalid" : "")"
                                               placeholder="Įveskite grupės pavadinimą..." required />
                                        <span asp-validation-for="group_name" class="text-danger"></span>
                                    </div>

                                    <!-- Nuotraukos preview -->
                                    <div class="d-flex flex-column align-items-center">
                                        <img id="imagePreview" src="~/Images/default.png"
                                             class="rounded-circle border shadow-sm mb-2"
                                             style="width: 90px; height: 90px; object-fit: cover;"
                                             alt="Preview">
                                        <input type="file" asp-for="formImage" class="form-control form-control-sm" id="imageInput" accept="image/*" />
                                        <small class="text-muted mt-1">Kvadratinė nuotrauka, iki 2MB</small>
                                    </div>

                                </div>
                            </div>

                        </div>

                        <!-- Veiksmai -->
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-dark px-5 fw-bold text-uppercase">Sukurti grupę</button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-4 fw-bold text-uppercase">Atšaukti</a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Nuotraukos preview
    document.getElementById('imageInput').onchange = evt => {
        const [file] = document.getElementById('imageInput').files;
        if (file) {
            document.getElementById('imagePreview').src = URL.createObjectURL(file);
        }
    }
</script>

<style>
    .form-control:focus {
        border-color: #212529;
        box-shadow: none;
    }
</style>

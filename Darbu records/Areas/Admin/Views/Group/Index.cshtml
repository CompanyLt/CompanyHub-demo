@using Darbu_records.Interfaces
@model List<CategoryGroup>

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h4 class="fw-bold mb-0 text-dark">Grupių sąrašas</h4>
            <small class="text-muted fw-bold text-uppercase" style="font-size: 0.7rem;">Iš viso: @Model.Count</small>
        </div>

        <div style="max-width:400px; width:100%;">
            <div class="input-group shadow-sm border rounded">
                <span class="input-group-text bg-white border-0">
                    <i class="fa fa-search text-muted"></i>
                </span>
                <input type="text" id="workerSearch"
                       class="form-control border-0 ps-0"
                       placeholder="Ieškoti grupes..."
                       style="box-shadow: none;">
            </div>
        </div>
    </div>

    <div class="row g-4" id="workerContainer">
        @foreach (var group in Model)
        {
            <div class="col-md-6 col-xl-4 col-xxl-3 worker-item">
                <div class="card border-0 shadow-lg worker-card h-100">

                    <div class="card-body d-flex align-items-center p-4">
                        @* AVATARAS *@
                        <div class="rounded-circle overflow-hidden shadow-sm me-3"
                             style="width: 55px; height: 55px; min-width: 55px;">

                            @if (group.recordFile != null &&
                           !string.IsNullOrEmpty(group.recordFile.name) &&
                           !string.IsNullOrEmpty(group.recordFile.directory))
                            {
                            <img src="/Access/GetFile?url=@group.recordFile.name&directory=@group.recordFile.directory"
                                 class="w-100 h-100"
                                 style="object-fit: cover;"
                                alt="Grupes nuotrauka">
                            }
                            else
                            {
                                <img src="/Images/departmentAvatar.png"
                                     class="w-100 h-100"
                                     style="object-fit: cover;"
                                     alt="Grupes nuotrauka">
                            }

                        </div>

                        <div class="overflow-hidden">
                            <h6 class="fw-bold mb-1 text-dark text-truncate">@group.Name</h6>                         
                        </div>
                    </div>

                    <div class="card-footer bg-light d-flex justify-content-between align-items-center px-4 py-3 border-0">
                        <span class="badge bg-success-subtle text-success border border-success-subtle text-uppercase" style="font-size: 0.6rem;">
                            Aktyvus
                        </span>

                        <div class="dropdown">
                            <button class="btn btn-sm btn-white border shadow-sm dropdown-toggle fw-bold text-uppercase"
                                    type="button"
                                    data-bs-toggle="dropdown"
                                    aria-expanded="false"
                                    style="font-size: 0.65rem;">
                                Veiksmai
                            </button>

                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-area="Admin"
                                       asp-controller="Group"
                                       asp-action="Details"
                                       asp-route-id="@group.Id">
                                        <i class="fa fa-info-circle me-2 text-primary"></i> Perziureti
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-area="Admin"
                                       asp-controller="Group"
                                       asp-action="Edit"
                                       asp-route-id="@group.Id">
                                        <i class="fa fa-pencil me-2 text-success"></i> Redaguoti
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2"
                                       asp-area="Admin"
                                       asp-controller="Category"
                                       asp-action="CategoryToGroup"
                                       asp-route-id="@group.Id">
                                        <i class="fa fa-pencil me-2 text-success"></i> Kategorijos
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item py-2 text-danger" href="#">
                                        <i class="fa fa-trash me-2"></i> Trinti
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>

</div>

<style>
    /* PAGRINDINĖ KORTELĖ */
    .worker-card {
        transition: all 0.25s ease-in-out;
        position: relative; /* Būtina z-index veikimui */
    }

        .worker-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.12) !important;
        }

        /* DROPDOWN SPRENDIMAS TELEFONUI */
        /* Kai dropdown atidaromas, iškeliame visą kortelę į viršų,
               kad meniu neužsidengtų po kitomis kortelėmis */
        .worker-card:has(.dropdown-toggle.show) {
            z-index: 9999 !important;
        }

        /* Jei :has dar nepalaikoma (senesni Safari), papildomas saugiklis fokusui */
        .worker-card:focus-within {
            z-index: 9999 !important;
        }

    .btn-white {
        background-color: #fff;
    }

    .dropdown-menu {
        z-index: 10000 !important;
        border-radius: 10px;
    }
</style>

@* PAIEŠKOS SKRIPTAS *@
<script>
    document.getElementById('workerSearch')?.addEventListener('input', function (e) {
        const text = e.target.value.toLowerCase();

        document.querySelectorAll('.worker-item').forEach(item => {
            // Randame vardą h6 viduje
            const name = item.querySelector('h6')?.innerText.toLowerCase() || "";

            // Tikriname, ar vardas atitinka paiešką
            if (name.includes(text)) {
                // Atstatome pirminį Bootstrap stilių (col klasės)
                item.style.display = '';
            } else {
                // Paslėpiame
                item.style.display = 'none';
            }
        });
    });
</script>
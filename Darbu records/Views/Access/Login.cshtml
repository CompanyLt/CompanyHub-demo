@using Darbu_records.Data
@model Login_validation
@{
    ViewData["Title"] = "Prisijungimas";
}

<div class="container">
    <div class="row justify-content-center align-items-center" style="min-height: 80vh;">
        <div class="col-12 col-md-6 col-lg-4">
            <div class="card shadow-lg border-0 rounded-3">

                <div class="card-header bg-dark text-white py-3 text-center border-0">
                    <h5 class="mb-0 text-uppercase fw-bold" style="letter-spacing: 1px;">
                        Prisijungimas
                    </h5>
                </div>

                <div class="card-body p-4 p-lg-5 bg-white">
                    <form asp-controller="Access" asp-action="user_login" method="post">

                        <div class="text-center mb-4">
                            <img src="~/Images/login.png"
                                 class="img-fluid rounded-circle border p-2 bg-light"
                                 width="120"
                                 alt="profile">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label small fw-bold text-muted text-uppercase">Naudotojo vardas</label>
                            <input asp-for="Name" type="text" class="form-control border-secondary-subtle" placeholder="Įveskite vardą...">
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label small fw-bold text-muted text-uppercase">Slaptažodis</label>
                            <input asp-for="Password" type="password" class="form-control border-secondary-subtle" placeholder="••••••••">
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 d-flex align-items-center">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input border-secondary-subtle" asp-for="rememberMe" id="remMe" />
                                <label class="form-check-label small text-muted" for="remMe">Prisiminti mane</label>
                            </div>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg text-uppercase fw-bold shadow-sm">
                                Prisijungti
                            </button>
                        </div>

                    </form>
                </div>
            </div>

            

        </div>
    </div>
</div>

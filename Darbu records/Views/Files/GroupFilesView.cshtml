@model List<CategoryGroup>
<div class="row g-4">
    @foreach (var group in Model)
    {
        <div class="col-md-4 col-sm-6 col-12">
            @* Pridėtas border-left stilius tiesiai ant kortelės *@
            <div class="card h-100 border-0 shadow-lg hover-raso-clean rounded-3 overflow-hidden" style="border-left: 5px solid #212529 !important;">

                <div class="card-body p-5 d-flex flex-column align-items-center justify-content-center position-relative">

                    <div class="mb-3 text-dark opacity-25">
                        <i class="fa fa-building-o fa-3x"></i>
                    </div>

                    <h5 class="card-title fw-bold text-dark text-uppercase m-0 text-center" style="letter-spacing: 2px;">
                        @group.Name
                    </h5>

                    <div class="mt-3 pt-3 border-top w-50 text-center">
                        <span class="small text-muted text-uppercase" style="font-size: 0.65rem;">Peržiūrėti</span>
                    </div>

                    <a asp-controller="Note"
                       asp-action="CategoriesNoteView"
                       asp-route-id="@group.Id"
                       class="stretched-link">
                    </a>
                </div>
            </div>
        </div>
    }
    <div class="text-center mt-5 pt-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm text-uppercase fw-bold border-0">
            <i class="fa fa-arrow-left me-2"></i> Grįžti į sąrašą
        </a>
    </div>
</div>

<style>
    .hover-raso-clean {
        transition: all 0.3s ease;
        background-color: #ffffff;
    }

        .hover-raso-clean:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
            background-color: #fcfcfc;
        }

            /* Užvedus pelę subtiliai paryškinam tekstą */
            .hover-raso-clean:hover .card-title {
                color: #000 !important;
            }

            .hover-raso-clean:hover .fa-building-o {
                opacity: 0.8;
                transition: 0.3s;
            }
</style>

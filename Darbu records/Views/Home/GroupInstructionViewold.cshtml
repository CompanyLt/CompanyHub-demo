@model List<CategoryGroup>



<div class="row g-4">
    @foreach (var group in Model)
    {
        <div class="col-md-4 col-sm-6 col-12">
            <div class="card h-100 border-0 shadow-lg hover-raso-clean rounded-3">
                
                <div class="card-body p-5 d-flex flex-column align-items-center justify-content-center position-relative">
                    
                    <div class="position-absolute top-0 start-0 end-0 bg-dark" style="height: 4px; border-radius: 3px 3px 0 0;"></div>

                    <div class="mb-3 text-dark opacity-25">
                        <i class="fa fa-building-o fa-3x"></i>
                    </div>

                    <h5 class="card-title fw-bold text-dark text-uppercase m-0 text-center" style="letter-spacing: 2px;">
                        @group.Name
                    </h5>
                    
                    <div class="mt-3 pt-3 border-top w-50 text-center">
                        <span class="small text-muted text-uppercase" style="font-size: 0.65rem;">Peržiūrėti</span>
                    </div>

                    <a asp-controller="Home" 
                       asp-action="CategoriesInstructionView" 
                       asp-route-categoryId="@group.Id" 
                       class="stretched-link">
                    </a>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .hover-raso-clean {
        transition: all 0.3s ease;
        background-color: #ffffff;
    }

    .hover-raso-clean:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 30px rgba(0,0,0,0.08) !important;
        background-color: #fcfcfc;
    }

    /* Užvedus pelę subtiliai paryškinam tekstą */
    .hover-raso-clean:hover .card-title {
        color: #000 !important;
    }
    
    .hover-raso-clean:hover .fa-building-o {
        opacity: 0.8;
        transition: 0.3s;
    }
</style>

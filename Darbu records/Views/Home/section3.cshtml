<div class="p-4 shadow-lg bg-white rounded-3 h-100 border-top border-dark border-5">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h4 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">
            <i class="fa fa-newspaper-o me-2"></i>Imones lenta
        </h4>
        <a href="#" class="btn btn-outline-dark btn-sm text-uppercase fw-bold" style="font-size: 0.7rem;">Visos naujienos</a>
    </div>

    <div class="row g-4">
        @for (int i = 1; i < 4; i++)
        {
            <div class="col-md-4 col-12">
                <div class="card h-100 border-0 shadow-sm hover-raso-news rounded-3 overflow-hidden">
                    <div class="position-relative">
                        <img src="~/img/news/whatNews@(i).jpg" class="card-img-top" alt="Naujiena" style="height: 200px; object-fit: cover;">
                        <div class="position-absolute top-0 start-0 m-2">
                            <span class="badge bg-dark text-white text-uppercase" style="font-size: 0.65rem; opacity: 0.9;">Kategorija</span>
                        </div>
                    </div>
                    <div class="card-body p-3">
                        <p class="text-muted small mb-1">@DateTime.Now.ToString("yyyy-MM-dd")</p>
                        <h6 class="card-title mb-0">
                            <a href="#" class="text-decoration-none text-dark fw-bold stretched-link hover-text-orange">
                                Kaip efektyviau naudotis RASO sistemomis?
                            </a>
                        </h6>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    /* Specialus efektas naujienų kortelėms */
    .hover-raso-news {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .hover-raso-news:hover {
            transform: translateY(-8px);
            box-shadow: 0 12px 25px rgba(0,0,0,0.15) !important;
        }

    /* Subtilus oranžinis akcentas iš tavo logotipo */
    .hover-text-orange:hover {
        color: #ff6600 !important; /* Naudok tikslią savo logotipo oranžinę */
    }

    /* Užtikrinam, kad nuotrauka gražiai prisitaikytų */
    .card-img-top {
        transition: transform 0.5s ease;
    }

    .hover-raso-news:hover .card-img-top {
        transform: scale(1.05);
    }
</style>
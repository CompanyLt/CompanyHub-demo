<div class="p-4 shadow-lg bg-white rounded-3 h-100 border-top border-dark border-5">
    @* --- ANTRAŠTĖ --- *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <h4 class="fw-bold m-0 text-uppercase" style="letter-spacing: 1px;">
            <i class="fa fa-share-alt me-2 text-primary"></i>BENDRINAMI RESURSAI <span class="text-muted fw-light">| Resursai</span>
        </h4>
        <div class="d-flex gap-2">
           
            <a asp-controller="ShareDesk" asp-action="Index" class="btn btn-dark btn-sm text-uppercase fw-bold" style="font-size: 0.7rem;">Atidaryti</a>
        </div>
    </div>

    <div class="row g-4">
        @* 1 pavyzdys: Instrukcijų grupė *@
        @await Component.InvokeAsync("ShareDesk",
                 new { stringName = "Default", shareType = "department" })

    </div>
</div>

<style>
    .hover-sharedesk {
        transition: all 0.3s cubic-bezier(0.25, 0.8, 0.25, 1);
    }

        .hover-sharedesk:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.12) !important;
        }

            /* Ikona fone šiek tiek pasisuka užvedus pelę */
            .hover-sharedesk:hover .fa.position-absolute {
                transform: rotate(-10deg) scale(1.1);
                transition: transform 0.5s ease;
            }
</style>
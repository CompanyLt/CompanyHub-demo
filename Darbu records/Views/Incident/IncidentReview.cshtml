<div class="container my-4">
    <div class="card shadow-lg">
        <div class="card-body">

            <!-- Note INFO Header -->
            <h3 class="text-primary text-center">Note INFO</h3>
            <hr class="border-primary">

            <!-- Pavadinimas -->
            <h5 class="mt-3 text-center">@Model.pavadinimas</h5>
            <p class="text-center">@Model.aprasymas</p>

            <!-- Sprendimas Section -->
            <h4 class="mt-4 text-success text-center">Sprendimas</h4>
            <hr class="border-success">
            <p class="text-center">@Model.sprendimas</p>

            <!-- Nuotraukos Section -->
           @*  @if (Model.photos.Any())
            {
                <h4 class="mt-4 text-info text-center">Nuotraukos</h4>
                <hr class="border-info">
                <div class="row g-3 justify-content-center">
                    @foreach (var p in Model.photos)
                    {
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <img src="~/incident/images/@p.name"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-width:100%; cursor:pointer;"
                                 alt="Nuotrauka"
                                 onclick="priartinimas(this)">
                        </div>
                    }
                </div>
            } *@

            @if (Model.photos.Any())
            {
                <h4 class="mt-4 text-info text-center">Nuotraukos</h4>
                <hr class="border-info">
                <div class="row g-3 justify-content-center">
                    @foreach (var p in Model.photos)
                    {
                        <div class="col-6 col-md-3 d-flex justify-content-center">
                            <img src="/Access/GetFile?url=@p.name&directory=@p.directory"
                                 class="img-fluid rounded shadow-sm"
                                 style="max-width:100%; cursor:pointer;"
                                 alt="Nuotrauka"
                                 onclick="priartinimas(this)">
                        </div>
                    }
                </div>
            }

            <!-- Failai Section -->
            @if (!string.IsNullOrEmpty(Model.file_name))
            {
                <h4 class="mt-4 text-warning text-center">Failai</h4>
                <hr class="border-warning">
                <div class="text-center mb-3">
                    <a href="/Access/GetFile?url=@Model.file_name&directory=@ViewData["tempDirectory"]" class="btn btn-outline-primary" download>
                        <i class="fa fa-download"></i> Atsisiųsti failą
                    </a>
                </div>
            }

        </div>
    </div>
</div>

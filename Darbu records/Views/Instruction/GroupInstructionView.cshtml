@model List<CategoryGroup>


@await Html.PartialAsync("~/Views/Shared/TopicSearch.cshtml")

<!-- Kortelių kolekcija -->
<div class="row g-4">
    @foreach (var group in Model)
    {
        <div class="col-md-4 col-sm-6 col-12 category-card" data-name="@group.Name.ToLower()">
            <div class="card h-100 border-0 shadow-lg hover-raso-clean rounded-3 overflow-hidden">
                <div class="card-body p-5 d-flex flex-column align-items-center justify-content-center position-relative pb-4">
                    <div class="position-absolute top-0 start-0 end-0 bg-dark" style="height: 4px;"></div>

                    <div class="mb-3">
                        @if (group.recordFile != null &&
                       !string.IsNullOrEmpty(group.recordFile.name) &&
                       !string.IsNullOrEmpty(group.recordFile.directory))
                        {
                            <img src="/Access/GetFile?url=@group.recordFile.name&directory=@group.recordFile.directory"
                                 class="img-fluid rounded-circle shadow-sm"
                                 style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                        else
                        {
                            <img src="~/Images/departmentAvatar.png"
                                 class="img-fluid rounded-circle shadow-sm"
                                 style="width: 70px; height: 70px; object-fit: cover;" />
                        }
                    </div>


                    <h5 class="card-title fw-bold text-dark text-uppercase m-0 text-center" style="letter-spacing: 2px;">
                        @group.Name
                    </h5>

                    <div class="mt-3 pt-3 border-top w-50 text-center mb-4">
                        <span class="small text-muted text-uppercase" style="font-size: 0.65rem;">Peržiūrėti</span>
                    </div>

                    <a asp-controller="Instruction"
                       asp-action="CategoriesInstructionView"
                       asp-route-id="@group.Id"
                       asp-route-department_access="@group.DepartmentAccess"
                       class="stretched-link"></a>
                </div>

                <!-- Apačios dalis su share mygtuku -->
                <div class="bg-light border-top py-2 text-center position-relative share-footer" style="z-index: 5;">
                    <button class="btn btn-share-link text-decoration-none text-muted fw-bold text-uppercase p-0 w-100"
                            style="font-size: 0.65rem; letter-spacing: 1px; height: 30px;"
                            data-bs-toggle="modal"
                            data-bs-target="#shareModal-@group.Id">
                        <i class="fa fa-share-alt me-1"></i> Dalintis grupe
                    </button>
                </div>
            </div>

           

            <!-- MODALAS -->
            <div class="modal fade" id="shareModal-@group.Id" tabindex="-1" aria-hidden="true" style="z-index: 1060;">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow-lg rounded-3 border-top border-dark border-5">
                        <div class="modal-header border-0 pb-0">
                            <h5 class="modal-title fw-bold text-uppercase" style="letter-spacing: 1px;">Dalintis: @group.Name</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body p-4 text-center">
                            <p class="text-muted mb-4 small text-uppercase fw-bold">Pasirinkite kam skirta forma</p>
                            <div class="row g-3">
                                <!-- Skyriui -->
                                <div class="col-6">
                                    <a asp-controller="ShareDesk"
                                       asp-action="InstructionGroupWithDepartment"
                                       asp-route-id="@group.Id"
                                       class="btn btn-light border w-100 py-4 hover-raso-side shadow-sm d-flex flex-column align-items-center text-decoration-none h-100">
                                        <i class="fa fa-users fa-2x mb-2 text-primary"></i>
                                        <span class="fw-bold text-uppercase small text-dark">Skyriui</span>
                                    </a>
                                </div>
                                <!-- Žmogui -->
                                <div class="col-6">
                                    <a asp-controller="#"
                                       asp-action="#"
                                       asp-route-id=""
                                       class="btn btn-light border w-100 py-4 hover-raso-side shadow-sm d-flex flex-column align-items-center text-decoration-none h-100">
                                        <i class="fa fa-user fa-2x mb-2 text-success"></i>
                                        <span class="fw-bold text-uppercase small text-dark">Žmogui</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer border-0 pt-0 justify-content-center">
                            <button type="button" class="btn btn-link btn-sm text-muted text-decoration-none text-uppercase fw-bold" data-bs-dismiss="modal">Atšaukti</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>



<style>
    /* Kortelės hover efektas */
    .hover-raso-clean {
        transition: all 0.3s ease;
        background-color: #ffffff;
    }

        .hover-raso-clean:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 30px rgba(0,0,0,0.15) !important;
        }

            .hover-raso-clean:hover img {
                transform: scale(1.08);
            }

    /* Share mygtukas stilius */
    .btn-share-link {
        background: none;
        border: none;
        outline: none !important;
        box-shadow: none !important;
        transition: all 0.2s ease;
    }

        .btn-share-link:hover {
            color: #000 !important;
        }

        .btn-share-link:active {
            transform: scale(0.95);
            color: #000 !important;
        }

    /* Apačios juostos efektas */
    .share-footer {
        transition: background-color 0.3s ease;
    }

    .hover-raso-clean:hover .share-footer {
        background-color: #f1f1f1 !important;
    }

    /* Modalo mygtukų hover */
    .hover-raso-side {
        transition: all 0.25s ease;
        border-radius: 12px;
    }

        .hover-raso-side:hover {
            background-color: #f8f9fa !important;
            transform: translateY(-3px);
            border-color: #212529 !important;
            box-shadow: 0 8px 20px rgba(0,0,0,0.08) !important;
        }
</style>

<!-- 🔧 JavaScript filtravimui -->


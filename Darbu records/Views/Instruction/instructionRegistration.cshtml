@using Darbu_records.Formos
@using Darbu_records.DAL
@using Darbu_records.Models.Topic
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Instrukcijos registravimas";
}
@model TopicForm


<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">

            <form asp-controller="Instruction" asp-action="InstructionAdd" method="post" enctype="multipart/form-data">

                

                <div class="card shadow-lg border-0 mb-3">
					<h4 class="mb-4 fw-bold text-uppercase border-bottom pb-2 ">
						<i class="bi bi-journal-plus me-2"></i>Instrukcijos registravimas
					</h4>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label asp-for="title" class="form-label small fw-bold text-muted text-uppercase">Pavadinimas</label>
                            <input asp-for="title" class="form-control border-secondary-subtle" placeholder="Įveskite instrukcijos antraštę..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label small fw-bold text-muted text-uppercase">Grupė</label>
                                <select id="groupSelect" asp-for="groupId" class="form-select border-secondary-subtle text-dark">
                                    @foreach (var group in Model.categoryGroup)
                                    {
                                        <option value="@group.Id">@group.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Kategorija</label>
                                <select asp-for="categoryId" id="categorySelect" class="form-select border-secondary-subtle">
                                    @foreach (var category in Model.categories)
                                    {
                                        <option value="@category.Id" data-group="@category.GroupId">@category.Name</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card shadow-lg border-0 mb-3">
                    <div class="card-body p-4">
                        <label asp-for="description" class="form-label small fw-bold text-muted text-uppercase">Instrukcijos aprašymas</label>
                        <textarea asp-for="description" class="form-control border-secondary-subtle" rows="8" placeholder="Žingsnis po žingsnio aprašykite procesą..."></textarea>
                    </div>
                </div>

                <div class="card shadow-lg border-0 mb-4">
                    <div class="card-body p-4">
                        <label class="form-label small fw-bold text-muted text-uppercase">Dokumentacija / Media</label>
                        <div id="drop-zone" class="border border-2 border-dashed rounded-3 p-4 text-center bg-light text-muted" style="cursor: pointer; border-style: dashed !important;">
                            <i class="bi bi-cloud-arrow-up fs-2 d-block mb-2"></i>
                            <span>Tempkite failus arba spustelėkite</span>
                        </div>
                        <input type="file" id="photosInput" name="formFiles" class="d-none" multiple />
                    </div>
					<div class="d-grid">
						<button type="submit" class="btn btn-dark btn-lg shadow fw-bold text-uppercase py-3">
							Išsaugoti instrukciją
						</button>
					</div>
                </div>

               

            </form>
        </div>
    </div>
</div>

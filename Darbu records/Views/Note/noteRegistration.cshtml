@using Darbu_records.Formos
@using Darbu_records.DAL
@using Darbu_records.Models.Topic
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    ViewData["Title"] = "Gedimo registravimas";
}
@model TopicForm

<div class="container py-4">
    <div class="row justify-content-center ">
        <div class="col-12 col-lg-8 ">

            <div class="card shadow-lg border-light">

                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 text-uppercase fw-bold" style="font-size: 1rem; letter-spacing: 1px;">
                        Užrašo registravimo forma
                    </h5>
                </div>

                <div class="card-body p-4 bg-white">
                    <form asp-controller="Note" asp-action="NoteAdd" method="post" enctype="multipart/form-data">

                        <div class="mb-3">
                            <label asp-for="title" class="form-label small fw-bold text-muted text-uppercase">Pavadinimas</label>
                            <input asp-for="title" class="form-control border-secondary-subtle" placeholder="Įveskite pavadinimą..." />
                            <span asp-validation-for="title" class="text-danger small"></span>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label small fw-bold text-muted text-uppercase">Grupė</label>
                                <select asp-for="groupId" id="groupSelect" class="form-select border-secondary-subtle">
                                    @foreach (var group in Model.categoryGroup)
                                    {
                                        <option value="@group.Id">@group.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted text-uppercase">Kategorija</label>
                                <select asp-for="categoryId" id="categorySelect" class="form-select border-secondary-subtle">
                                    @foreach (var category in Model.categories)
                                    {
                                        <option value="@category.Id" data-group="@category.GroupId">
                                            @category.Name
                                        </option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="description" class="form-label small fw-bold text-muted text-uppercase">Aprašymas</label>
                            <textarea asp-for="description" class="form-control border-secondary-subtle" rows="4"></textarea>
                            <span asp-validation-for="description" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="solution" class="form-label small fw-bold text-muted text-uppercase">Sprendimas</label>
                            <textarea asp-for="solution" class="form-control border-secondary-subtle" rows="4"></textarea>
                            <span asp-validation-for="solution" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-muted text-uppercase">Failu ikelimas</label>

                            <div id="drop-zone"
                                 class="border border-2 border-dashed rounded-3 p-4 text-center bg-light text-muted"
                                 style="cursor: pointer; border-style: dashed !important;">
                                <i class="bi bi-cloud-upload fs-2 d-block mb-2"></i> <span>Tempkite failus cia arba spustelekite</span>
                            </div>

                            <input type="file" id="photosInput" name="formFiles" class="d-none" />
                        </div>

                        <div class="d-grid gap-2 pt-3 border-top">
                            <button type="submit" name="patvirtinti" class="btn btn-dark btn-lg text-uppercase fw-bold shadow-sm">
                                Patvirtinti
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>


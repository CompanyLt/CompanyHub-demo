
@using Darbu_records.Models.Topic
@model TopicForm;

<div class="container my-5">
    @* PAGRINDINĖ KORTELĖ *@
    <div class="card shadow-lg border-0 rounded-3 overflow-hidden">

        @* HEADERIS: Šviesus ir privatus *@
        <div class="p-4 p-md-5 text-center border-bottom bg-white">
            <div class="d-flex justify-content-center align-items-center mb-2">
                <i class="fa fa-lock text-muted me-2" style="font-size: 0.8rem;"></i>
                <span class="text-muted small text-uppercase fw-bold" style="letter-spacing: 2px;">Privatus užrašas</span>
            </div>
            <h2 class="fw-bold text-dark m-0 text-uppercase" style="letter-spacing: 1px;">@Model.title</h2>
        </div>

        <div class="card-body p-4 p-md-5">

            @* APRAŠYMAS: Subtilus „Notebook“ stilius *@
            <div class="row justify-content-center mb-5">
                <div class="col-lg-11">
                    <div class="p-4 rounded-3 border-start border-4 border-secondary shadow-sm"
                         style="background-color: #fdfdfd; border-left-color: #ced4da !important;">
                       
                        <p class="text-dark mb-0" style="line-height: 1.8; font-size: 1.1rem; font-style: italic;">
                            @Model.description
                        </p>
                    </div>
                </div>
            </div>

            @* PDF SKYRIUS *@
            @if (Model.fileForm.pdfCollection.Any())
            {
                @foreach (var file in Model.fileForm.pdfCollection)
                {
                    <div class="mb-4">
                        <div class="ratio ratio-16x9 shadow-sm rounded overflow-hidden border">
                            <iframe src="/Access/GetPdfFile?url=@file.name&directory=@file.directory" allowfullscreen></iframe>
                        </div>
                    </div>
                }
            }

            @* NUOTRAUKŲ SKYRIUS: Tavo originali logika *@
            @if (Model.fileForm.photosCollection.Any())
            {
                <div class="mb-5">
                    <h6 class="fw-bold text-uppercase small text-muted border-bottom pb-2 mb-4">
                        <i class="fa fa-image me-2"></i> Vizualinė medžiaga
                    </h6>
                    <div class="row g-3">
                        @foreach (var p in Model.fileForm.photosCollection)
                        {
                            <div class="col-6 col-md-4 col-lg-3">
                                <div class="rounded shadow-sm overflow-hidden bg-light" style="height: 150px;">
                                    <img src="/Access/GetFile?url=@p.name&directory=@p.directory"
                                         class="img-fluid w-100 h-100"
                                         style="object-fit: cover; cursor: pointer;"
                                         alt="Nuotrauka"
                                         onclick="priartinimas(this)">
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* FAILŲ SKYRIUS: Per visą plotį (col-12) *@
            @if (Model.fileForm.filesCollection.Any())
            {
                <div class="mb-4">
                    <h6 class="fw-bold text-uppercase small text-muted border-bottom pb-2 mb-4">
                        <i class="fa fa-download me-2"></i> Priedai ir failai
                    </h6>

                    <div class="row">
                        @foreach (var file in Model.fileForm.filesCollection)
                        {
                            <div class="col-12 mb-3">
                                <div class="border rounded-3 p-3 shadow-sm d-flex justify-content-between align-items-center bg-white">
                                    <div class="d-flex align-items-center overflow-hidden">
                                        <i class="fa fa-file-o text-dark fs-4 me-3"></i>
                                        <div class="text-truncate">
                                            <div class="fw-bold text-dark mb-0 text-truncate" style="font-size: 0.9rem;">@file.originalName</div>
                                            <small class="text-muted" style="font-size: 0.8rem;">Įkelta: @file.upload_date.ToString("yyyy-MM-dd")</small>
                                        </div>
                                    </div>

                                    <a href="/Access/GetFile?url=@file.name&directory=@file.directory"
                                       class="btn btn-dark btn-sm fw-bold text-uppercase px-4 ms-2" style="font-size: 0.7rem; min-width: 110px;">
                                        <i class="fa fa-download me-1"></i> Atsisiųsti
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* NAVIGACIJA *@
            <div class="text-center mt-5 pt-3">
                <a href="javascript:history.back()" class="btn btn-outline-secondary btn-sm text-uppercase fw-bold border-0">
                    <i class="fa fa-arrow-left me-2"></i> Grįžti į sąrašą
                </a>
            </div>

        </div>
    </div>
</div>



<style>
    /* Sugrąžintas nuotraukų didinimo efektas tavo originaliam onclick */
    .hover-zoom img {
        transition: transform 0.3s ease;
    }

    .hover-zoom:hover img {
        transform: scale(1.1);
    }
</style>
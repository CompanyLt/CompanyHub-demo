@using Darbu_records.Formos
@model TaskForm

<!-- Incidentai -->
@if (Model.incidentCollection.Any())
{
    <h4 class="mt-4 mb-3 text-primary">Incidentai</h4>
    <div class="row g-3 mb-5">
        @foreach (var list in Model.incidentCollection)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">@list.pavadinimas</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="card-text flex-grow-1">@list.aprasymas</p>

                        <ul class="list-inline mb-3">
                            <li class="list-inline-item"><i class="fa fa-comment me-1"></i>Comments: 0</li>
                            <li class="list-inline-item"><i class="fa fa-thumbs-up me-1"></i>Likes: 0</li>
                        </ul>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <form asp-area="" asp-controller="Incident" asp-action="IncidentDelete" asp-route-id="@list.iraso_id" class="m-0">
                                <button type="submit" class="btn btn-danger btn-sm">Ištrinti</button>
                            </form>
                            <form asp-area="" asp-controller="Incident" asp-action="IncidentUpdate"
                                  asp-route-iraso_id="@list.iraso_id"
                                  asp-route-pavadinimas="@list.pavadinimas"
                                  asp-route-aprasymas="@list.aprasymas"
                                  asp-route-sprendimas="@list.sprendimas" class="m-0">
                                <button type="submit" class="btn btn-warning btn-sm">Redaguoti</button>
                            </form>
                            <form asp-area="" asp-controller="Incident" asp-action="incidentReview" asp-route-incident_id="@list.iraso_id" class="m-0">
                                <button type="submit" class="btn btn-info btn-sm text-white">Info</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

<!-- Instrukcijos -->
@if (Model.instructionCollection.Any())
{
    <h4 class="mt-4 mb-3 text-success">Instrukcijos</h4>
    <div class="row g-3">
        @foreach (var list in Model.instructionCollection)
        {
            <div class="col-12 col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0">@list.pavadinimas</h5>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <p class="card-text flex-grow-1">@list.aprasymas</p>
                        <ul class="list-inline mb-3">
                            <li class="list-inline-item"><i class="fa fa-comment me-1"></i>Comments: 0</li>
                            <li class="list-inline-item"><i class="fa fa-thumbs-up me-1"></i>Likes: @(list.patinka - 1)</li>
                        </ul>

                        <div class="d-flex flex-wrap gap-2 mt-auto">
                            <form asp-area="" asp-controller="Instruction" asp-action="InstructionDelete" asp-route-id="@list.iraso_id" class="m-0">
                                <button type="submit" class="btn btn-danger btn-sm">Ištrinti</button>
                            </form>
                            <form asp-area="" asp-controller="Instruction" asp-action="InstructionUpdate"
                                  asp-route-id="@list.iraso_id"
                                  asp-route-title="@list.pavadinimas"
                                  asp-route-description="@list.aprasymas" class="m-0">
                                <button type="submit" class="btn btn-warning btn-sm">Redaguoti</button>
                            </form>
                            <form asp-area="" asp-controller="Instruction" asp-action="instructionReview"
                                  asp-route-instruction_id="@list.iraso_id" class="m-0">
                                <button type="submit" class="btn btn-info btn-sm text-white">Info</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!Model.incidentCollection.Any() && !Model.instructionCollection.Any())
{
    <p>Irašų nėra.</p>
}

@using Darbu_records.Formos;
@model InstructionForm;


<script>
    function priartinimas(nuotrauka) {
        nuotrauka.classList.toggle("priartinimas");
    }
</script>




<div class="info_meniu">


<div class="review">
        <h1>Note INFO</h1>
    <hr style="height:2px;border-width:0;color:gray;background-color:gray">
    <form class="patinka_forma" asp-asp-controller="Home" asp-action="Patinka_pridejimas"
          asp-route-pavadinimas="@Model.pavadinimas"
          asp-route-aprasymas="@Model.aprasymas"
          asp-route-id="@Model.iraso_id"
          asp-route-patinka="@Model.patinka">

        <button id="like_mygtukas" type="submit">
            <img id="patinka_dydis" src="/like.jpg" alt="nuotrauka" />
        </button>
        <div>: @(Model.patinka - 1)</div>
    </form>

        <h2>@Model.pavadinimas</h2>
    <hr style="height:2px;border-width:0;color:gray;background-color:gray">
    <textarea>@Model.aprasymas</textarea>
    <h1>Nuotraukos</h1>
    <hr style="height:2px;border-width:0;color:gray;background-color:gray">
    <div class="collage">
            <img src="~/image/@Model.file_name" alt="Nuotraukos nera" class="nuotrauka" id="1nuotrauka" onclick="priartinimas(this)" />
      
    </div>





</div>
</div>